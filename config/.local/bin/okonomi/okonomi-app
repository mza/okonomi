# Main
# ═══════════════════════════════════════════════════════════════════

case "${1:-}" in
    init)     cmd_init "$2" ;;
    list)     cmd_list ;;
    status)   cmd_status "$2" ;;
    logdump)  cmd_logdump "$2" "$3" ;;
    dev)      cmd_dev "$2" "$3" "$4" "$5" ;;
    test)     cmd_test "$2" "$3" "$4" "$5" ;;
    prod)     cmd_prod "$2" "$3" "$4" "$5" ;;
    help|--help|-h|"") cmd_help ;;
    version)  echo "Okonomi v$VERSION" ;;
    *)
        log_error "Unknown command: $1"
        echo "Run 'okonomi help' for usage"
        exit 1
        ;;
esac
