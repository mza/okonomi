#!/bin/bash
# Launch a registered bin in floating terminal
# Usage: okonomi-launch-bin <bin-name>

bin_name="$1"
if [ -z "$bin_name" ]; then
    echo "Error: bin name required"
    exit 1
fi

# Use the runner to execute the bin
runner="${HOME}/.local/bin/okonomi/okonomi-ai-run-bin"

cmd="$runner $bin_name; echo; read -n1 -p 'Press any key to close...'"
exec setsid uwsm-app -- alacritty --class=Imagine -e bash -c "$cmd"
