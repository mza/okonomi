#!/bin/bash

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-a" "$index")
    fi 
  fi

  echo -e "$options" | vicinae dmenu --placeholder "$prompt…" --section-title "Quick links" "${args[@]}"
}

show_main_menu() {
  go_to_menu "$(menu "Okonomi" "Bins\nSpaces\nAssistants\nCapture\nSystem\n")"
}

show_bins_menu() {
  case $(menu "Bins" "Create") in
  *Create*) okonomi-launch-imagine;;
  esac
}

show_assistants_menu() {
  case $(menu "Assistants" "ChatGPT\nClaude") in
  *ChatGPT*) okonomi-launch-webapp "https://chatgpt.com";;
  *Claude*) okonomi-launch-webapp "https://claude.com";;
  esac
}

show_spaces_menu() {
  case $(menu "Spaces" "Create") in
  *Create*) okonomi-launch-imagine;;
  esac
}

show_system_menu() {
  case $(menu "System" "Screensaver\nLock\nRestart\nShutdown\n") in
  *Screensaver*) okonomi-launch-screensaver;;
  *Lock*) okonomi-lock;;
  *Restart*) systemctl reboot;;
  *Shutdown*) systemctl poweroff;;
  esac
}

show_capture_menu() {
  case $(menu "Monitor" "Color picker\nScreenshot\nScreen recording\n") in
  *picker*) okonomi-cmd-colorpicker;;
  *Screenshot*) okonomi-cmd-screenshot;;
  *recording*) okonomi-cmd-screenrecord;;
  esac
}

go_to_menu() {
  case "${1,,}" in
  *bins*) show_bins_menu;;
  *spaces*) show_spaces_menu;;
  *assistants*) show_assistants_menu;;
  *capture*) show_capture_menu;;
  *system*) show_system_menu;;
  esac
}

show_main_menu
