#!/bin/bash

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-a" "$index")
    fi 
  fi

  echo -e "$options" | vicinae dmenu --placeholder "$prompt…" --section-title "Quick links" "${args[@]}"
}

show_main_menu() {
  go_to_menu "$(menu "Okonomi" "Bins\nSpaces\nAssistants\nCapture\nSystem\n")"
}

show_bins_menu() {
  # Build dynamic menu from registered bins
  local bins
  bins=$(okonomi-list-bin-names)

  local menu_items="Create"
  if [ -n "$bins" ]; then
    # Add registered bins to menu
    while IFS= read -r bin_name; do
      menu_items="${menu_items}\n${bin_name}"
    done <<< "$bins"
  fi
  menu_items="${menu_items}\nManage"

  local choice
  choice=$(menu "Bins" "$menu_items")

  case "${choice,,}" in
  *create*)
    okonomi-launch-create-bin
    ;;
  *manage*)
    setsid uwsm-app -- alacritty --class=Imagine -e ~/.local/bin/okonomi/okonomi-ai-manage-bins
    ;;
  *)
    # Launch the selected bin in floating terminal
    if [ -n "$choice" ]; then
      okonomi-launch-bin "$choice"
    fi
    ;;
  esac
}

show_assistants_menu() {
  case $(menu "Assistants" "ChatGPT\nClaude") in
  *ChatGPT*) okonomi-launch-webapp "https://chatgpt.com";;
  *Claude*) okonomi-launch-webapp "https://claude.com";;
  esac
}

show_spaces_menu() {
  case $(menu "Spaces" "Create") in
  *Create*) okonomi-launch-imagine;;
  esac
}

show_system_menu() {
  case $(menu "System" "Screensaver\nLock\nRestart\nShutdown\n") in
  *Screensaver*) okonomi-launch-screensaver;;
  *Lock*) okonomi-lock;;
  *Restart*) systemctl reboot;;
  *Shutdown*) systemctl poweroff;;
  esac
}

show_capture_menu() {
  case $(menu "Monitor" "Color picker\nScreenshot\nScreen recording\n") in
  *picker*) okonomi-cmd-colorpicker;;
  *Screenshot*) okonomi-cmd-screenshot;;
  *recording*) okonomi-cmd-screenrecord;;
  esac
}

go_to_menu() {
  case "${1,,}" in
  *bins*) show_bins_menu;;
  *spaces*) show_spaces_menu;;
  *assistants*) show_assistants_menu;;
  *capture*) show_capture_menu;;
  *system*) show_system_menu;;
  esac
}

show_main_menu
