#!/bin/bash
# Create a new bin using AI, register it, and install it
# Usage: okonomi-ai-create-bin [model]

set -e

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

# Get model (optional first argument, or use default from config)
if [ -z "$1" ]; then
    DEFAULT_MODEL=$(~/.local/bin/ai model get 2>/dev/null || echo "gpt-oss")
    MODEL="$DEFAULT_MODEL"
else
    MODEL="$1"
fi

echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${BLUE}           Okonomi AI - Create Bin Wizard                      ${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo -e "${YELLOW}Using model: ${MODEL}${NC}"
echo ""

# Get description of what to build (only input needed)
echo "What should this bin do?"
echo -n "Description: "
read -r DESCRIPTION

if [ -z "$DESCRIPTION" ]; then
    echo -e "${RED}Error: Description required${NC}"
    exit 1
fi

# Create work directory
WORK_DIR="/tmp/okonomi-ai-bin-$$"
mkdir -p "$WORK_DIR"
cd "$WORK_DIR"

echo ""
echo -e "${BLUE}Step 1: Running AI agent to create the bin...${NC}"
echo "Task: $DESCRIPTION"
echo ""

# Use AI to generate the script content
AI_COMPLETE="${HOME}/.config/ai/helpers/complete"

SYSTEM_PROMPT="You are a utility script generator. Generate a complete, working bash script based on the user's description.

CRITICAL: OUTPUT MUST BE BASH, NOT PYTHON OR ANY OTHER LANGUAGE.

Requirements:
1. Start with #!/bin/bash shebang
2. Include clear comments explaining what the script does
3. Use 'set -e' for error handling
4. Include helpful usage messages
5. Make it production-ready and robust
6. Add --help flag support
7. Add --version flag showing v1.0.0
8. Keep it focused and simple
9. MUST BE BASH - no Python, JavaScript, or other languages

Also suggest a short, kebab-case name for the script (like 'coin-toss', 'git-sync', 'db-backup').

Format your response EXACTLY like this:
NAME: suggested-script-name
DESCRIPTION: One-line description of what it does

SCRIPT:
#!/bin/bash
# Script content here
...rest of script...

Do not include any other text, markdown code blocks, or explanations outside this format."

FULL_PROMPT="$SYSTEM_PROMPT

User request: $DESCRIPTION"

echo "Generating script with AI..."
AI_RESPONSE=$("$AI_COMPLETE" "$MODEL" "$FULL_PROMPT")

if [ -z "$AI_RESPONSE" ]; then
    echo -e "${RED}Error: Failed to generate script${NC}"
    exit 1
fi

# Parse the response
BIN_NAME=$(echo "$AI_RESPONSE" | grep "^NAME:" | sed 's/^NAME: *//')
BIN_DESCRIPTION=$(echo "$AI_RESPONSE" | grep "^DESCRIPTION:" | sed 's/^DESCRIPTION: *//')
SCRIPT_CONTENT=$(echo "$AI_RESPONSE" | sed -n '/^SCRIPT:/,$ p' | tail -n +2)

if [ -z "$BIN_NAME" ] || [ -z "$SCRIPT_CONTENT" ]; then
    echo -e "${RED}Error: AI response was not in the expected format${NC}"
    echo "Response:"
    echo "$AI_RESPONSE"
    exit 1
fi

# Create the script file
GENERATED_FILE="$WORK_DIR/$BIN_NAME"
echo "$SCRIPT_CONTENT" > "$GENERATED_FILE"
chmod +x "$GENERATED_FILE"

echo ""
echo -e "${GREEN}✓ Script generated${NC}"
echo ""

echo -e "${BLUE}Step 2: Registering bin...${NC}"
echo ""
echo -e "${GREEN}AI chose the name: ${BIN_NAME}${NC}"
echo ""

# Prepare the file
chmod +x "$GENERATED_FILE"

# Show preview
echo "Generated script preview:"
echo "────────────────────────────────────────────────────────────────"
head -20 "$GENERATED_FILE"
echo "..."
echo "────────────────────────────────────────────────────────────────"
echo ""

read -p "Looks good? [Y/n]: " CONFIRM
CONFIRM=${CONFIRM:-Y}

if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}Cancelled. Generated file at: $GENERATED_FILE${NC}"
    exit 0
fi

# Copy to bins directory with versioned structure
BINS_DIR="${HOME}/.local/share/ai/bins"
BIN_PATH="$BINS_DIR/$BIN_NAME"
mkdir -p "$BIN_PATH"

# Create v1
cp "$GENERATED_FILE" "$BIN_PATH/v1"
chmod +x "$BIN_PATH/v1"

# Create current symlink
ln -s v1 "$BIN_PATH/current"

# Register it with version metadata
REGISTRY_FILE="${HOME}/.config/ai/bins/registry.json"
if [ ! -f "$REGISTRY_FILE" ]; then
    mkdir -p "$(dirname "$REGISTRY_FILE")"
    echo '{"version":"1.0","bins":{}}' > "$REGISTRY_FILE"
fi

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
AUTHOR=$(whoami)

# Add to registry using jq with versioning (use AI's description if available)
jq --arg desc "${BIN_DESCRIPTION:-$DESCRIPTION}" \
   --arg author "$AUTHOR" \
   --arg timestamp "$TIMESTAMP" \
   --arg path "$BIN_PATH" \
   --arg model "$MODEL" \
   ".bins[\"$BIN_NAME\"] = {
    \"version\": \"1\",
    \"current_version\": \"v1\",
    \"description\": \$desc,
    \"author\": \$author,
    \"created\": \$timestamp,
    \"updated\": \$timestamp,
    \"path\": \$path,
    \"generated_by\": \"okonomi-ai\",
    \"model\": \$model,
    \"versions\": {
        \"v1\": {
            \"created\": \$timestamp,
            \"prompt\": null,
            \"parent\": null
        }
    }
}" "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp"
mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"

echo -e "${GREEN}✓ Registered $BIN_NAME${NC}"
echo ""

echo -e "${BLUE}Step 3: Installing bin to PATH...${NC}"

# Install it (create wrapper that uses runner)
"${HOME}/.local/bin/okonomi/okonomi-ai-install-bin" "$BIN_NAME"

echo -e "${GREEN}✓ Installed $BIN_NAME${NC}"
echo ""

# Cleanup work directory
rm -rf "$WORK_DIR"

# Summary
echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}                    Success!                                   ${NC}"
echo -e "${GREEN}═══════════════════════════════════════════════════════════════${NC}"
echo ""
echo "Bin '$BIN_NAME' has been created, registered, and installed!"
echo ""
echo "Try it now:"
echo "  $BIN_NAME --help"
echo "  $BIN_NAME --version"
echo ""
echo "Bin details:"
echo "  Location: $BIN_PATH"
echo "  Version: v1"
echo ""
echo "Run it:"
echo "  $BIN_NAME --help"
echo "  $BIN_NAME --version"
echo ""
echo "Manage with:"
echo "  • Bins menu → $BIN_NAME → Modify/Versions"
echo "  • Command line: okonomi-ai-modify-bin $BIN_NAME"
echo ""
