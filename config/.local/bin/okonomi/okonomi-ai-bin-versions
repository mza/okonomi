#!/bin/bash
# View and manage bin version history

REGISTRY_FILE="${HOME}/.config/ai/bins/registry.json"

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

bin_name="$1"

if [ -z "$bin_name" ]; then
    echo "Usage: okonomi-ai-bin-versions <bin-name>"
    exit 1
fi

# Check if bin exists
if ! jq -e ".bins[\"$bin_name\"]" "$REGISTRY_FILE" > /dev/null 2>&1; then
    echo "Error: Bin '${bin_name}' not found in registry."
    exit 1
fi

# Get bin info
bin_path=$(jq -r ".bins[\"$bin_name\"].path" "$REGISTRY_FILE")
current_version=$(jq -r ".bins[\"$bin_name\"].current_version" "$REGISTRY_FILE")

while true; do
    clear
    echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║   Version History: ${bin_name}${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
    echo

    # Get all versions sorted
    versions=$(jq -r ".bins[\"$bin_name\"].versions | keys[]" "$REGISTRY_FILE" | sort -V)

    # Display versions
    while IFS= read -r version; do
        created=$(jq -r ".bins[\"$bin_name\"].versions[\"$version\"].created" "$REGISTRY_FILE")
        prompt=$(jq -r ".bins[\"$bin_name\"].versions[\"$version\"].prompt // \"Original version\"" "$REGISTRY_FILE")

        # Format timestamp
        created_date=$(date -d "$created" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$created")

        if [ "$version" = "$current_version" ]; then
            echo -e "  ${GREEN}${version} (current)${NC} - ${created_date}"
        else
            echo -e "  ${YELLOW}${version}${NC} - ${created_date}"
        fi
        echo -e "     ${prompt}"
        echo
    done <<< "$versions"

    echo -e "${BLUE}Actions:${NC}"
    echo "  1. Switch to version"
    echo "  2. Compare versions (diff)"
    echo "  b. Back"
    echo
    echo -n "Select action: "
    read -r action

    case "$action" in
        1)
            # Switch version
            echo
            echo -n "Enter version to switch to (e.g., v1): "
            read -r target_version

            if ! jq -e ".bins[\"$bin_name\"].versions[\"$target_version\"]" "$REGISTRY_FILE" > /dev/null 2>&1; then
                echo -e "${RED}Error: Version '${target_version}' not found.${NC}"
                sleep 2
                continue
            fi

            # Update current symlink
            ln -sf "$target_version" "${bin_path}/current"

            # Update registry
            timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
            jq ".bins[\"$bin_name\"].current_version = \"$target_version\" |
                .bins[\"$bin_name\"].updated = \"$timestamp\"" "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp"
            mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"

            echo -e "${GREEN}✓ Switched to ${target_version}${NC}"
            sleep 1
            ;;
        2)
            # Compare versions
            echo
            echo -n "Enter first version (e.g., v1): "
            read -r version1
            echo -n "Enter second version (e.g., v2): "
            read -r version2

            if [ ! -f "${bin_path}/${version1}" ] || [ ! -f "${bin_path}/${version2}" ]; then
                echo -e "${RED}Error: One or both versions not found.${NC}"
                sleep 2
                continue
            fi

            clear
            echo -e "${BLUE}╔════════════════════════════════════════╗${NC}"
            echo -e "${BLUE}║   Diff: ${version1} → ${version2}${NC}"
            echo -e "${BLUE}╚════════════════════════════════════════╝${NC}"
            echo

            diff -u "${bin_path}/${version1}" "${bin_path}/${version2}" || true

            echo
            echo "Press any key to continue..."
            read -n1 -s
            ;;
        b|B)
            break
            ;;
        *)
            echo -e "${RED}Invalid action.${NC}"
            sleep 1
            ;;
    esac
done
