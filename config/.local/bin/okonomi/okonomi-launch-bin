#!/bin/bash
# Launch a registered bin in floating terminal
# Usage: okonomi-launch-bin <bin-name>

bin_name="$1"
if [ -z "$bin_name" ]; then
    echo "Error: bin name required"
    exit 1
fi

bin_path="$HOME/.local/share/ai/bins/$bin_name"

if [ ! -f "$bin_path" ]; then
    # Try direct command if not in bins dir
    bin_path="$bin_name"
fi

cmd="$bin_path; echo; read -n1 -p 'Press any key to close...'"
exec setsid uwsm-app -- alacritty --class=Imagine -e bash -c "$cmd"
