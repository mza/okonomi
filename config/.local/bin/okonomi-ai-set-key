#!/bin/bash
# Set API key in central config
# Usage: okonomi-ai-set-key <key_name> <key_value>

CONFIG_FILE="${HOME}/.config/ai/config.json"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Config file not found: $CONFIG_FILE"
    exit 1
fi

KEY_NAME="$1"
KEY_VALUE="$2"

if [ -z "$KEY_NAME" ]; then
    echo "Error: Key name required"
    echo "Usage: okonomi-ai-set-key <key_name> <key_value>"
    echo "Available: anthropic, openai, litellm_master"
    exit 1
fi

if [ -z "$KEY_VALUE" ]; then
    # Interactive mode
    read -sp "Enter API key for ${KEY_NAME}: " KEY_VALUE
    echo
    if [ -z "$KEY_VALUE" ]; then
        echo "Error: No key provided"
        exit 1
    fi
fi

# Update config
jq ".api_keys.${KEY_NAME} = \"${KEY_VALUE}\"" "$CONFIG_FILE" > "${CONFIG_FILE}.tmp"
mv "${CONFIG_FILE}.tmp" "$CONFIG_FILE"

# Set restrictive permissions
chmod 600 "$CONFIG_FILE"

echo "✓ API key for '${KEY_NAME}' has been set"
echo "✓ Config file permissions set to 600 (owner read/write only)"
