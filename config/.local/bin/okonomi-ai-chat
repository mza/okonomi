#!/bin/bash
# Quick chat with AI assistant for Okonomi development
# Usage: okonomi-ai-chat [model]

# Get default model if not specified
if [ -z "$1" ]; then
    DEFAULT_MODEL=$(~/.local/bin/ai model get 2>/dev/null || echo "gpt-oss")
    MODEL="$DEFAULT_MODEL"
else
    MODEL="$1"
fi

~/.local/bin/ai chat "$MODEL"
