#!/bin/bash
# AI-powered bin creation - just describe what you want!
# Usage: okonomi-cmd-create-bin

set -e

REGISTRY_FILE="${HOME}/.config/ai/bins/registry.json"
BINS_DIR="${HOME}/.local/share/ai/bins"
MODEL=$(~/.local/bin/ai model get 2>/dev/null || echo "gpt-oss")
AI_COMPLETE="${HOME}/.config/ai/helpers/complete"

echo "╔════════════════════════════════════════════════════════════╗"
echo "║           AI-Powered Bin Creator                          ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""
echo "Describe the utility you want to create."
echo "Examples:"
echo "  • A tool that formats JSON files"
echo "  • A script to compress images in a directory"
echo "  • A quick note-taking utility"
echo ""
echo -n "What do you want: "
read -r USER_PROMPT

if [ -z "$USER_PROMPT" ]; then
    echo "Error: No description provided"
    exit 1
fi

echo ""
echo "Generating utility with AI ($MODEL)..."
echo ""

# Create the full prompt for the AI
SYSTEM_PROMPT="You are a utility script generator. Generate a complete, working bash script based on the user's description.

Requirements:
1. Start with #!/bin/bash shebang
2. Include clear comments explaining what the script does
3. Handle errors gracefully (use set -e)
4. Include helpful usage messages
5. Make it production-ready and robust
6. Add --help flag support
7. Keep it focused and simple

Also suggest a short, kebab-case name for the script (like 'json-formatter' or 'image-compressor').

Format your response EXACTLY like this:
NAME: suggested-script-name
DESCRIPTION: One-line description of what it does

SCRIPT:
#!/bin/bash
# Script content here
...rest of script...

Do not include any other text or explanations outside this format."

# Make API call to generate the script
FULL_PROMPT="$SYSTEM_PROMPT

User request: $USER_PROMPT"

AI_RESPONSE=$("$AI_COMPLETE" "$MODEL" "$FULL_PROMPT")

if [ -z "$AI_RESPONSE" ]; then
    echo "Error: Failed to generate script"
    exit 1
fi

# Parse the response to extract name, description, and script
BIN_NAME=$(echo "$AI_RESPONSE" | grep "^NAME:" | sed 's/^NAME: *//')
BIN_DESCRIPTION=$(echo "$AI_RESPONSE" | grep "^DESCRIPTION:" | sed 's/^DESCRIPTION: *//')
SCRIPT_CONTENT=$(echo "$AI_RESPONSE" | sed -n '/^SCRIPT:/,$ p' | tail -n +2)

if [ -z "$BIN_NAME" ] || [ -z "$SCRIPT_CONTENT" ]; then
    echo "Error: AI response was not in the expected format"
    echo "Response:"
    echo "$AI_RESPONSE"
    exit 1
fi

# Check if bin already exists
if jq -e ".bins.\"$BIN_NAME\"" "$REGISTRY_FILE" > /dev/null 2>&1; then
    echo "Error: Bin '$BIN_NAME' already exists"
    echo "Suggested name: ${BIN_NAME}-2"
    read -p "Enter a different name: " NEW_NAME
    if [ -n "$NEW_NAME" ]; then
        BIN_NAME="$NEW_NAME"
    else
        exit 1
    fi
fi

echo "Creating: $BIN_NAME"
echo "Description: $BIN_DESCRIPTION"
echo ""

# Create the bin file
BIN_PATH="$BINS_DIR/$BIN_NAME"
mkdir -p "$BINS_DIR"
echo "$SCRIPT_CONTENT" > "$BIN_PATH"
chmod +x "$BIN_PATH"

# Register it
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
jq ".bins.\"$BIN_NAME\" = {
    \"version\": \"1.0.0\",
    \"description\": \"$BIN_DESCRIPTION\",
    \"author\": \"AI Generated\",
    \"created\": \"$TIMESTAMP\",
    \"updated\": \"$TIMESTAMP\",
    \"path\": \"$BIN_PATH\"
}" "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp"
mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"

# Install it
ln -sf "$BIN_PATH" "$HOME/.local/bin/$BIN_NAME"

echo "✓ Created at: $BIN_PATH"
echo "✓ Registered in bins system"
echo "✓ Installed to ~/.local/bin/$BIN_NAME"
echo ""
echo "════════════════════════════════════════════════════════════"
echo "Ready to use!"
echo ""
echo "Run it:"
echo "  • From menu: Okonomi → Bins → $BIN_NAME"
echo "  • From terminal: $BIN_NAME"
echo "  • View code: cat $BIN_PATH"
echo "════════════════════════════════════════════════════════════"
